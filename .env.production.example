########################################################################
# Staffvora — production .env template
#
# Copy this to .env ON THE SERVER and fill in the values. Never commit the
# real .env, and never paste real values into chat, a document or a
# screenshot. Full instructions: documents/PRODUCTION_DEPLOYMENT.md §4
#
# After ANY change here, run:  php artisan config:cache
# To check the result, run:    php artisan deploy:preflight
########################################################################

# ── Application ───────────────────────────────────────────────────────
APP_NAME="Staffvora"
APP_ENV=production
# Generate ONCE with: php artisan key:generate --force
# Never regenerate it later — existing encrypted data becomes unreadable
# and every signed-in user is logged out.
APP_KEY=
# Must stay false. If true, every error page shows your database password.
APP_DEBUG=false
APP_URL=https://staffvora.com
APP_TIMEZONE=UTC

# Host the operator/landlord console is served on. Wildcard DNS already
# points *.staffvora.com at the VPS; this still needs its own nginx block
# and to be included in the certificate.
PLATFORM_HOST=platform.staffvora.com

# ── Brand / legal ─────────────────────────────────────────────────────
BRAND_NAME="Staffvora"
# The REGISTERED company name. Appears on invoices and in the Terms.
BRAND_LEGAL_NAME=""
BRAND_SUPPORT_EMAIL="hello@staffvora.com"
BRAND_SALES_EMAIL="hello@staffvora.com"
BRAND_ADDRESS=""
BRAND_PHONE=""
BRAND_WHATSAPP=""
BRAND_DEMO_URL=""

# ── Logging ───────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────
# Staffvora gets its OWN database and user. Never share one with another
# product on the same VPS.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Sessions / cache / queue ──────────────────────────────────────────
# MUST be `file`. This template used to say `database` with a note about git
# deploys wiping the file store — which is sound advice for a project that HAS
# a sessions table. This one does not: there is no create_sessions_table
# migration anywhere in database/migrations, so `database` produces
# "Base table or view not found: staffvora.sessions" on the very first request
# and the whole site 500s. That is exactly what happened on the first
# staffvora.com deploy.
#
# If you want database sessions later, add the sessions migration FIRST, run it,
# and only then change this line. Sessions live under storage/framework/sessions,
# which is outside the git tree, so an ordinary `git pull` deploy does not clear
# them; only a fresh clone would.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# Leave blank unless you deliberately want one cookie shared across
# subdomains. The operator console does NOT need it.
SESSION_DOMAIN=

CACHE_DRIVER=file
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# QUEUE: `database` is the app default and REQUIRES something to drain it —
# either a supervised `queue:work`, or the every-minute scheduled drain that
# only runs if the schedule:run cron is installed. With neither, queued work
# silently never happens. See PRODUCTION_DEPLOYMENT.md §6.3.
QUEUE_CONNECTION=database

# ── Mail ──────────────────────────────────────────────────────────────
# Without working mail nobody can accept an invitation or reset a password.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Must be a real mailbox on the staffvora.com domain — not a placeholder.
MAIL_FROM_ADDRESS="hello@staffvora.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── File storage (S3) ─────────────────────────────────────────────────
# Screenshots and avatars MUST NOT live inside the deployed folder — a git
# deploy deletes untracked files there. Use a bucket dedicated to Staffvora
# with its own IAM user. Objects stay private, served via signed URLs.
SCREENSHOTS_DRIVER=s3
AVATARS_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
SCREENSHOTS_BUCKET=
AVATARS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Desktop app ───────────────────────────────────────────────────────
# Absolute path to the installers folder, which must sit OUTSIDE the
# deployed code. Serves both the /download page and the auto-update feed
# at https://staffvora.com/desktop-updates.
# See documents/DESKTOP_RELEASE_CHECKLIST.md
DESKTOP_INSTALLERS_PATH=

# ── Scheduler ─────────────────────────────────────────────────────────
# Only needed for the URL-based scheduler fallback (an external pinger hits
# /cron/run/<token> every minute when the panel cron is unreliable). Use a
# long random string, 32-128 letters and digits. Leave BLANK to disable the
# endpoint entirely. The normal path is the crontab entry in §6.4.
SCHEDULER_HTTP_TOKEN=

# ── Optional integrations — leave blank until you actually want them ───

# Slack reporting (documents/SLACK_INTEGRATION.md)
SLACK_REPORT_WEBHOOK_URL=
SLACK_WEEKLY_REPORT_ENABLED=false
SLACK_REPORT_TIMEZONE=Asia/Karachi
SLACK_BOT_TOKEN=
SLACK_DAILY_DIGEST_ENABLED=false
SLACK_DIGEST_CHANNEL=
SLACK_CLOCKIN_CHANNEL=
SLACK_TRACKER_HEALTH_CHANNEL=
SLACK_SIGNING_SECRET=

# Attendance automations. Off by default so they can be reviewed with a dry
# run before the scheduler starts closing live sessions.
ATTENDANCE_AUTO_CLOCKOUT=false
ATTENDANCE_STILL_WORKING_SLACK=false
TRACKER_HEALTH_SLACK=false

# AI day summaries (Growth plan and above). Blank = the feature stays off.
ANTHROPIC_API_KEY=

# Online card gateway. LEAVE UNSET — no payment gateway is wired yet, and
# nothing in the product may imply self-serve card checkout until one is.
BILLING_GATEWAY=
BILLING_SUPPORT_EMAIL="hello@staffvora.com"

# ── Front-end build ───────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Do NOT set these in production ────────────────────────────────────
# ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD create an admin via a seeder.
# Use `php artisan tenant:create "Company" you@staffvora.com` instead — it
# provisions the organization, owner, team, settings and trial together.
# Every user must belong to an organization; an org-less account would be
# able to read and write every customer's data.
