{
  "name": "timetracker-desktop",
  "productName": "SA Track",
  "version": "0.3.4",
  "description": "Desktop screenshot tracker for the Timetracker web app",
  "main": "main/main.js",
  "author": {
    "name": "Spark"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:setup": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:fast": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -SkipMigrate -SkipRebuild",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --x64",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "rebuild": "electron-rebuild -f -w better-sqlite3,uiohook-napi"
  },
  "dependencies": {
    "active-win": "^8.2.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.0",
    "jimp": "^0.22.12",
    "screenshot-desktop": "^1.15.0",
    "uiohook-napi": "^1.5.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.spark.timetracker.desktop",
    "productName": "SA Track",
    "publish": [
      {
        "provider": "generic",
        "url": "https://timetracker.sparkingasia.com/desktop-updates"
      }
    ],
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/screenshot-desktop/**/*"
    ],
    "protocols": [
      {
        "name": "Timetracker",
        "schemes": [
          "timetracker"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Timetracker reads the active application name to record work activity."
      }
    },
    "dmg": {
      "title": "SA Track"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SA Track",
      "include": "build/installer.nsh"
    }
  }
}
