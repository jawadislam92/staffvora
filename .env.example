# Local development template. For a SERVER, copy .env.production.example
# instead — it is annotated and carries the production-only keys.

APP_NAME=Staffvora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BRAND_NAME=Staffvora
BRAND_LEGAL_NAME=Staffvora
BRAND_SUPPORT_EMAIL=hello@staffvora.com
BRAND_SALES_EMAIL=hello@staffvora.com
BRAND_ADDRESS=
BRAND_PHONE=
BRAND_WHATSAPP=
BRAND_DEMO_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=time_tracker
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

SLACK_REPORT_WEBHOOK_URL=
SLACK_WEEKLY_REPORT_ENABLED=false
SLACK_REPORT_TIMEZONE=Asia/Karachi

# Desktop app
# Absolute path to the folder holding the built installers and their
# electron-updater manifests (latest.yml / latest-mac.yml). Leave blank locally
# to fall back to storage/app/desktop-installers and desktop/dist-app. On a
# server this MUST be outside the deployed tree — a git deploy wipes untracked
# files inside it. See documents/DESKTOP_RELEASE_CHECKLIST.md.
DESKTOP_INSTALLERS_PATH=
# Optional. Overrides Machine::MIN_AGENT_VERSION (the Machine Compliance
# stale-agent threshold) as plain x.y.z. Leave blank unless a fleet is still
# mid-update; anything that is not x.y.z is ignored.
DESKTOP_MIN_AGENT_VERSION=
# Optional. Name of an nginx `internal` location that maps onto
# DESKTOP_INSTALLERS_PATH. Set it and PHP hands the ~100 MB installer transfer
# to nginx (X-Accel-Redirect) instead of pinning an FPM worker for the whole
# download. LEAVE BLANK unless that location actually exists in the nginx
# config — with a prefix set and no matching location every download 404s.
# config/desktop.php carries the exact server-block snippet.
DESKTOP_X_ACCEL_PREFIX=
# Optional. Per-IP-per-minute budget for installer downloads. Raise it if a
# large office behind one NAT'd address is throttled mid-rollout.
DESKTOP_PAYLOAD_HITS_PER_MINUTE=60
DESKTOP_PAYLOAD_RANGE_HITS_PER_MINUTE=240
